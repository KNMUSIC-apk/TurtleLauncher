<?xml version="1.0" encoding="utf-8"?>
<!-- Open download section tab: a translucent light fill under a bright frame. The fill is a
     colour with its own alpha (not a layer-list item alpha), so the label stays readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3DF2F5F0"/>
    <corners android:radius="@dimen/radius_item"/>
    <stroke android:width="1dp" android:color="@color/accent_primary"/>
</shape>
