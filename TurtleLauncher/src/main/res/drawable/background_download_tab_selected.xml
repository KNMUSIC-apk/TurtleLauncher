<?xml version="1.0" encoding="utf-8"?>
<!-- Filled background for the open download section tab: a soft accent fill under a brighter frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.22">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_primary"/>
            <corners android:radius="@dimen/radius_item"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_item"/>
            <stroke android:width="1dp" android:color="@color/accent_primary"/>
        </shape>
    </item>
</layer-list>
