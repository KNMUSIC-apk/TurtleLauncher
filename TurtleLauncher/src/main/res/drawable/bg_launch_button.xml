<?xml version="1.0" encoding="utf-8"?>
<!-- Play button: Cyplix violet-to-blue gradient. Pressed and hovered states use solid tones. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/launch_button_ripple">
    <item>
        <selector xmlns:android="http://schemas.android.com/apk/res/android">
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/launch_button_pressed"/>
                    <corners android:radius="@dimen/radius_dialog"/>
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/launch_button_hover"/>
                    <corners android:radius="@dimen/radius_dialog"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/accent_primary"
                        android:endColor="@color/accent_cyan"
                        android:type="linear"/>
                    <corners android:radius="@dimen/radius_dialog"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
