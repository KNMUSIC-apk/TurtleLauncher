<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:ignore="UseSwitchCompatOrMaterialXml">

    <LinearLayout
        android:id="@+id/sub_settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m">

        <ImageButton
            android:id="@+id/sub_settings_back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_setting_hud"
            android:tint="@color/accent_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/setting_category_hud"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/turtle_text_primary"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_12sdp">

            <!-- Live preview of the in-game HUD card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                    <include
                        android:id="@+id/game_menu_preview"
                        layout="@layout/view_game_info_hud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal" />
            </LinearLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_hud_stats"
                    android:textColor="@color/accent_primary" />
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudShowCpu_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudShowCpu_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowCpu"
                        android:text="@string/setting_hud_stat_cpu_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudShowCpu_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudShowCpu_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowCpu"
                        android:text="@string/setting_hud_stat_cpu_desc" />
                    <Switch
                        android:id="@+id/hudShowCpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudShowGpu_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudShowGpu_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowGpu"
                        android:text="@string/setting_hud_stat_gpu_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudShowGpu_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudShowGpu_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowGpu"
                        android:text="@string/setting_hud_stat_gpu_desc" />
                    <Switch
                        android:id="@+id/hudShowGpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudShowRam_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudShowRam_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowRam"
                        android:text="@string/setting_hud_stat_ram_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudShowRam_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudShowRam_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowRam"
                        android:text="@string/setting_hud_stat_ram_desc" />
                    <Switch
                        android:id="@+id/hudShowRam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudShowFps_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudShowFps_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowFps"
                        android:text="@string/setting_hud_stat_fps_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudShowFps_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudShowFps_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowFps"
                        android:text="@string/setting_hud_stat_fps_desc" />
                    <Switch
                        android:id="@+id/hudShowFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudShowPing_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudShowPing_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowPing"
                        android:text="@string/setting_hud_stat_ping_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudShowPing_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudShowPing_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/hudShowPing"
                        android:text="@string/setting_hud_stat_ping_desc" />
                    <Switch
                        android:id="@+id/hudShowPing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_hud_game_buttons"
                    android:textColor="@color/accent_primary" />
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/showScreenshotButtonHud_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/showScreenshotButtonHud_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showScreenshotButtonHud"
                        android:text="@string/setting_hud_screenshot_button_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/showScreenshotButtonHud_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/showScreenshotButtonHud_title"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:layout_toStartOf="@+id/showScreenshotButtonHud"
                        android:text="@string/setting_hud_screenshot_button_desc" />
                    <Switch
                        android:id="@+id/showScreenshotButtonHud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:text="@string/setting_category_hud_display"
                    android:textColor="@color/accent_primary" />
                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/gameMenuLocation_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/_12sdp">
    
                    <TextView
                        android:id="@+id/gameMenuLocation_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:text="@string/setting_game_menu_location_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/gameMenuLocation_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuLocation_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:text="@string/setting_game_menu_location_center" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/gameMenuInfoRefreshRate_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground">
    
                    <TextView
                        android:id="@+id/gameMenuInfoRefreshRate_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/setting_game_menu_info_refresh_rate_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/gameMenuInfoRefreshRate_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuInfoRefreshRate_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:text="@string/setting_game_menu_info_refresh_rate_desc" />
    
                    <SeekBar
                        android:id="@+id/gameMenuInfoRefreshRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/gameMenuInfoRefreshRate_value"
                        android:layout_alignBottom="@+id/gameMenuInfoRefreshRate_value"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/gameMenuInfoRefreshRate_value"
                        android:max="5000"
                        android:min="500" />
    
                    <TextView
                        android:id="@+id/gameMenuInfoRefreshRate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuInfoRefreshRate_summary"
                        android:layout_alignParentEnd="true"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        tools:text="0" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/gameMenuAlpha_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground">
    
                    <TextView
                        android:id="@+id/gameMenuAlpha_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/setting_game_menu_alpha_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/gameMenuAlpha_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuAlpha_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:text="@string/setting_game_menu_alpha_desc" />
    
                    <SeekBar
                        android:id="@+id/gameMenuAlpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/gameMenuAlpha_value"
                        android:layout_alignBottom="@+id/gameMenuAlpha_value"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/gameMenuAlpha_value"
                        android:max="100"
                        android:min="20" />
    
                    <TextView
                        android:id="@+id/gameMenuAlpha_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gameMenuAlpha_summary"
                        android:layout_alignParentEnd="true"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        tools:text="0" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudModuleScale_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_12sdp">
                    <TextView
                        android:id="@+id/hudModuleScale_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_hud_module_scale_title"
                        android:textColor="@color/turtle_primary_text" />
                    <TextView
                        android:id="@+id/hudModuleScale_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudModuleScale_title"
                        android:text="@string/setting_hud_module_scale_desc" />
                    <TextView
                        android:id="@+id/hudModuleScale_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                    <SeekBar
                        android:id="@+id/hudModuleScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudModuleScale_summary"
                        android:max="150"
                        android:min="50" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/hudAlpha_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground">
    
                    <TextView
                        android:id="@+id/hudAlpha_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/setting_hud_alpha_title"
                        android:textColor="@color/turtle_primary_text" />
    
                    <TextView
                        android:id="@+id/hudAlpha_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudAlpha_title"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:text="@string/setting_hud_alpha_desc" />
    
                    <SeekBar
                        android:id="@+id/hudAlpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/hudAlpha_value"
                        android:layout_alignBottom="@+id/hudAlpha_value"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/hudAlpha_value"
                        android:max="100"
                        android:min="20" />
    
                    <TextView
                        android:id="@+id/hudAlpha_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/hudAlpha_summary"
                        android:layout_alignParentEnd="true"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        tools:text="0" />
                </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>

</LinearLayout>
